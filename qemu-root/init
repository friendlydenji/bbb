#!/bin/sh

export PATH=/bin:/sbin

# Tạo mount points
busybox mkdir -p /proc /sys /dev

# Mount filesystem
busybox mount -t proc proc /proc
busybox mount -t sysfs sysfs /sys
busybox mount -t devtmpfs devtmpfs /dev

# Mount tracefs
busybox mkdir -p /sys/kernel/tracing
busybox mount -t tracefs tracefs /sys/kernel/tracing

echo "=== QEMU Linux ready ==="

busybox dmesg | busybox tail -n 20

# Start interactive shell
exec /bin/busybox setsid /bin/busybox cttyhack /bin/sh